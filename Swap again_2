#include <iostream>

void swap(int* pointer_a, int* pointer_b)
{
    int temporary = *pointer_a;
    *pointer_a = *pointer_b;
    *pointer_b = temporary;
}

int main() 
{
    int a = 5, b = 8;

    std::cout << "a = " << a << ", b = " << b << std::endl;

    swap(&a, &b);

    std::cout << "a = " << a << ", b = " << b << std::endl;

    return EXIT_SUCCESS;
}
